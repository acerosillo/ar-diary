# Copy this file to .env and fill in your own values. Never commit .env.
#
# Leave both TURSO_ variables blank to run against a local SQLite file
# (./local.db) instead — handy for trying the app before you have a
# Turso database. The server code is identical either way; libSQL
# speaks the same protocol to a local file or to Turso's hosted service.
#
# To point at a real Turso database:
#   1. Install the CLI:        curl -sSfL https://get.tur.so/install.sh | bash
#   2. Sign in:                 turso auth login
#   3. Create a database:       turso db create ar-diary
#   4. Get the URL:             turso db show ar-diary --url
#   5. Create a token:          turso db tokens create ar-diary
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required for the read-only /read.html page (entries you mark "Share this
# entry" show up there). Pick any phrase and set the same value in Netlify's
# environment variables — whoever you send the link to needs this passcode.
# Leave blank and the /read.html page refuses to show anything.
SHARED_PASSCODE=

PORT=3000
